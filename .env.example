# Скопируйте в .env и заполните. Все параметры необязательны: без них система
# работает в офлайн-режиме (база знаний + правила), без внешних сервисов.

# --- Сервер ---
# Где хранить базу (store_agent.sqlite3) и модели; по умолчанию папка data рядом с кодом
# DATA_DIR=C:gent-data
# MODELS_DIR=C:gent-data\models
HOST=127.0.0.1
PORT=8000
# Публичный адрес сайта/сервера: используется в ссылках на КП и счета в письмах и Telegram
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Секрет для подписи cookie админки (обязательно смените в продакшене)
SECRET_KEY=change-me-please
ADMIN_PASSWORD=admin
# Токен для внешних интеграций (телефония, мессенджеры) -> POST /api/channels/inbound
INTEGRATION_TOKEN=
# Разрешённые источники для виджета (через запятую), * — любые
WIDGET_ALLOWED_ORIGINS=*

# --- ИИ-режим (необязательно) ---
# По умолчанию ассистент работает на внутренних моделях: правила, собственный классификатор
# и нейросеть, дообученная на ваших переписках. Ключ ниже подключает внешнюю языковую модель по API;
# при этом тексты диалогов передаются её провайдеру — учтите в политике обработки персональных данных.
LLM_API_KEY=
# LLM_MODEL=   — модель по умолчанию задана в коде
# low | medium | high — глубина рассуждений; low = быстрее и дешевле
LLM_EFFORT=low
# 1 = включить серверный резервный переход на другую модель при отказе
LLM_FALLBACKS=1
# 1 = принудительно офлайн-режим, даже если ключ указан
LLM_DISABLED=0

# --- Email-канал (IMAP входящие + SMTP исходящие) ---
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_POLL_SECONDS=60

# --- Telegram-канал (бот для клиентов) ---
TELEGRAM_BOT_TOKEN=

# --- Уведомления менеджерам об эскалациях ---
MANAGER_TELEGRAM_CHAT_ID=
MANAGER_EMAIL=
